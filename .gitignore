# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# unrelated installers that happened to live in this folder — kept, not tracked
/_source/unrelated/

# per-machine Claude Code settings: absolute paths and personal permission
# grants. .claude/launch.json IS tracked — that one is project config.
.claude/settings.local.json

# visual QA sheets for the garment mattes — regenerate with
# `node scripts/qa-cutouts.mjs`. Output, not source.
/.qa/

.vercel
.env*
